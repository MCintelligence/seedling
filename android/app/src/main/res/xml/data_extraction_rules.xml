<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="cache/" />
        <exclude domain="root" path="code_cache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="cache/" />
    </device-transfer>
</data-extraction-rules>
